+def _auto_set_hermes_task(args) -> None:
+    """Plan F Week 3 Day 6 (2026-08-21 prime-agent runtime 串接):
+    自動設定 HERMES_TASK 環境變數（讓 build_skills_system_prompt 按 per_task 過濾）
