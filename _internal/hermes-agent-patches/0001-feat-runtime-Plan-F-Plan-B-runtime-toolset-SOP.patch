+      2. args.skill (舊版 — 對位 per_task)
+      3. 從 args.skills[0] 反推
+      4. 已存在 HERMES_TASK env → 不覆寫
+    """
+    if os.environ.get("HERMES_TASK"):
+        return  # 已設定，不覆寫
