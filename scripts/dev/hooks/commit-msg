#!/usr/bin/env bash
# atlas-wiki commit-msg hook v2 (T3-A258 kaecer "B" 拍板)
# 對位 SOUL §0.1 例外 6 + v6.46 規範修改
#
# 對位 T3-A257 候選 B 真實描述:
# - 「嚴格 (#N) 真實 PR 編號」(移除 (refs #N) 後門)
# - (T3-Axxx) 編號移除(那是 governance-log 內,不是 commit message level)
# - chore / fix 例外保持(對位既有 v6.x 模式)
# - 文檔 / build 例外保持
#
# v1 vs v2 對位:
# - v1 接受 (refs #N) / (T3-Axxx) / (#N) 三種 → v2 只接受 (#N)+ chore/fix/build 例外
# - 對位 PR #8 commit message 含 2 次 (...(#8)) 中後者是 v1 後門造成的冗餘,v2 拒絕
#
# kaecer 2026-08-04 12:47 拍板 走 B = T3-A258

set -e

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
FIRST_LINE=$(printf '%s\n' "$COMMIT_MSG" | head -n 1)

# 例外跳過
if [ "${HUSKY_SKIP_COMMIT_MSG:-0}" = "1" ]; then
    echo "⚠️  HUSKY_SKIP_COMMIT_MSG=1(緊急 hotfix 模式,需事後 T3 evidence 補 governance-log)"
    exit 0
fi

# T3-A? 對位 B 拒絕(用 #N 取代)
if printf '%s' "$FIRST_LINE" | grep -qE '\(T3-A[0-9]+\)'; then
    echo "❌ commit message 第一行禁止 (T3-Axxx) 編號(對位 T3-A258 + B 拍板)"
    echo "   應改寫為 (#N) 真實 PR 編號"
    echo "   your first line: [ $FIRST_LINE ]"
    echo ""
    echo "⚠️  如果是 governance-log 內文變更,不是 commit message,請用 補丁檔/PATCH 寫入(不要 commit)"
    exit 1
fi

# 後門 refs #N 拒絕
if printf '%s' "$FIRST_LINE" | grep -qE 'refs #'; then
    echo "❌ commit message 第一行禁止 (refs #N) 後門(對位 T3-A258 + B 拍板)"
    echo "   應改寫為直接 (#N) 真實 PR 編號(不重複,不縮寫)"
    echo "   your first line: [ $FIRST_LINE ]"
    exit 1
fi

# 判斷 commit message type
# feat(...) / fix(...) → 必須含 (#N) 真實 PR
# chore: / docs: / build: / ci: / refactor: / style: / test: → 為例外的非 merge commit
#   兩種格式共存:「type(scope):」與「type:」
COMMIT_TYPE=$(printf '%s' "$FIRST_LINE" | sed -nE 's/^([a-z]+)([(: ]).*/\1/p')

case "$COMMIT_TYPE" in
    feat|fix)
        # 嚴格要求 (#N) 形式
        if ! printf '%s' "$FIRST_LINE" | grep -qE '\(#[0-9]+\)'; then
            echo "❌ feat/fix commit 必須含 (#N) 真實 PR 編號(對位 T3-A258 + B 拍板)"
            echo "   correct format:"
            echo "     feat(atlas-wiki): <subject> (#PR_NUMBER)"
            echo "     fix(atlas-wiki): <subject> (#PR_NUMBER)"
            echo "   your first line: [ $FIRST_LINE ]"
            echo ""
            echo "⚠️  例外路徑(對位 break-glass hotfix):HUSKY_SKIP_COMMIT_MSG=1 + commit message body 註明 hotfix 理由"
            exit 1
        fi
        ;;
    chore|docs|build|ci|refactor|style|test)
        # 例外:允許
        ;;
    *)
        # 其他未識別 type 不自動放行 → 鼓勵改用正確 type
        echo "⚠️  未識別的 commit type: '$COMMIT_TYPE'(對位 conventional commits)"
        echo "   接受類型: feat / fix / chore / docs / build / ci / refactor / style / test"
        echo "   your first line: [ $FIRST_LINE ]"
        exit 1
        ;;
esac

exit 0
